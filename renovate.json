{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": "^Dockerfile$",
      "matchStrings": [
        "# renovate: (?<depName>[^\\n]+)\\n\\s+[-]\\s+([\"'])?(?<currentValue>[^\\n\"']+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ]
}
